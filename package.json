{
  "name": "obsidian-math-block",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin for concise mathematical blocks with native links.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "check": "pnpm lint && pnpm test && pnpm build && pnpm peers check",
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint src tests",
    "test": "vitest run --dir tests"
  },
  "keywords": [
    "obsidian",
    "block",
    "mathematics"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.15.17",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.11"
  }
}
